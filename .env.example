# Local development configuration. Copy to .env and fill in; never commit a real .env.
# Every variable is described in docs/configuration.md. A test fails if this file and that page drift.
#
# After `azd provision`, you can print most deployment values with:  azd env get-values

# ---- Model and agent runtime ----------------------------------------------------------------
# Required: your Azure OpenAI v1 base URL and the name of the chat model deployment.
AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
AZURE_AI_MODEL_DEPLOYMENT_NAME=YOUR_MODEL_DEPLOYMENT_NAME
PORT=8088

# Foundry project (durable conversations in the cloud). Both names read the same value.
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
AZURE_AI_PROJECT_ENDPOINT=

# Reasoning effort of the main model: minimal, low (default), medium or high. Empty keeps the provider default.
MODEL_REASONING_EFFORT=low
MODEL_TIMEOUT_SECONDS=90
MODEL_MAX_RETRIES=2
# Fast path for tool-free turns: a first call without tools answers simple questions directly.
MODEL_FAST_PATH=true

# Consent judge. Empty uses the main model; changing it requires re-measuring pass^k.
SEMANTIC_APPROVAL_MODEL=
SEMANTIC_APPROVAL_TIMEOUT=10

# Foundry Toolbox (web search, code interpreter). Leave empty to disable.
TOOLBOX_ENDPOINT=

# ---- Notion ------------------------------------------------------------------------------------
# Dynamic discovery protects every tool that is not explicitly read-only.
NOTION_MCP_ENABLED=false
NOTION_BACKEND=direct
NOTION_MCP_URL=https://mcp.notion.com/mcp
NOTION_TOOL_POLICY=dynamic
NOTION_READ_TOOL_NAMES=
NOTION_WRITE_TOOL_NAMES=
NOTION_TOOLBOX_NAME=sa2-notion-tools
NOTION_IDENTITY_DIAGNOSTICS=false

# Direct chat OAuth. The agent and the BFF callback must share the same store and key.
NOTION_OAUTH_CALLBACK_URL=
NOTION_OAUTH_STORE_URL=
# Local loopback only. In the cloud the key is a Key Vault secret (scripts/setup/generate-notion-key.sh).
NOTION_OAUTH_ENCRYPTION_KEY=
NOTION_LOCAL_USER_ID=
# Fixed key of the single owner. Same value on the agent and the BFF; required in the cloud.
NOTION_OWNER_ID=

# Cloud only: Key Vault secret for the encryption key and the identity that reads it.
# Leave blank locally to use NOTION_OAUTH_ENCRYPTION_KEY and your developer credentials.
NOTION_OAUTH_KEY_VAULT_URL=
NOTION_OAUTH_KEY_VAULT_SECRET_NAME=
NOTION_OAUTH_MANAGED_IDENTITY_CLIENT_ID=

# ---- SSH tool (optional, all or nothing) --------------------------------------------------------
# Runs commands on a Linux VM as a dedicated account. The private key is a Key Vault secret, never
# a file or a variable. Prepare these with scripts/setup/ssh-setup.sh.
# SSH_HOST=
# SSH_PORT=22
# SSH_USER=
# SSH_HOST_KEY=ssh-ed25519 AAAA...   # public host key, pinned (no trust on first use)
# SSH_KEY_VAULT_URL=https://<vault>.vault.azure.net
# SSH_KEY_SECRET_NAME=
# SSH_CONNECT_TIMEOUT=10
# SSH_COMMAND_TIMEOUT=30

# ---- Project documents (Azure AI Search) --------------------------------------------------------
# SEARCH_ENDPOINT turns on the agent's search_documents tool. Entra ID only, no key.
SEARCH_ENDPOINT=
SEARCH_INDEX=sa2-docs
# BFF: indexer started after an upload.
SEARCH_INDEXER=sa2-docs-indexer
# Pipeline script only (scripts/search_setup.py, docs/search-documents.md):
# SEARCH_STORAGE_RESOURCE_ID=/subscriptions/<id>/resourceGroups/<group>/providers/Microsoft.Storage/storageAccounts/<name>
# SEARCH_EMBEDDING_ENDPOINT=https://<account>.services.ai.azure.com
# SEARCH_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# SEARCH_EMBEDDING_MODEL=text-embedding-3-small
# SEARCH_DOCUMENTS_CONTAINER=documents

# ---- BFF (web backend) ---------------------------------------------------------------------------
# Routes for the web interface. AGENT_RESPONSES_URL enables /api/chat; set it last, after Easy Auth
# works, and only together with NOTION_OWNER_ID (above) and BFF_OWNER_OBJECT_ID.
AGENT_RESPONSES_URL=
BFF_OWNER_OBJECT_ID=
# Only when the web interface runs on another origin, for example http://localhost:5173
PWA_ORIGIN=
OAUTH_CALLBACK_PORT=8090

# Voice (both or neither): AI Services custom-domain origin and its region. The BFF identity needs
# "Cognitive Services Speech Contributor" on that resource; no key is used.
SPEECH_ENDPOINT=
SPEECH_REGION=

# Projects and sessions (Cosmos DB for NoSQL, Entra ID, no key). Without COSMOS_ENDPOINT the BFF
# serves no /api/projects or /api/sessions and chat is unchanged.
COSMOS_ENDPOINT=
COSMOS_DATABASE=sa2

# Project documents: upload, list and delete (needs SEARCH_ENDPOINT too).
DOCUMENTS_ACCOUNT_URL=
DOCUMENTS_CONTAINER=documents
