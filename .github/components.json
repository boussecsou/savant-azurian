        "src/savant/bff_documents.py"
      ],
      "ci": ["tests/test_bff*.py", "tests/test_oauth*.py", "tests/test_notion_oauth.py", "tests/test_component*.py", "tests/test_package_bff.py", "scripts/smoke_test_bff.py", "scripts/component_changes.py", "scripts/release_plan.py", "bff/**", ".github/workflows/ci.yml", ".github/workflows/publish-bff.yml"]
